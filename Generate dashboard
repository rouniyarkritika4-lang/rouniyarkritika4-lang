# ---------------------------------------------------------------------------
# CONFIG — edit me
# ---------------------------------------------------------------------------
METRICS = [
    {"label": "Total Stars", "value": 42, "color": "#39d9ff"},
    {"label": "Total Commits", "value": 1380, "color": "#39d353"},
    {"label": "Pull Requests", "value": 27, "color": "#b06bff"},
    {"label": "Day Streak", "value": 14, "color": "#ff9d3d"},
]

LANGUAGES = [
    {"name": "Python", "pct": 46, "color": "#39d9ff"},
    {"name": "JavaScript", "pct": 22, "color": "#ff9d3d"},
    {"name": "Java", "pct": 14, "color": "#b06bff"},
    {"name": "HTML/CSS", "pct": 11, "color": "#39d353"},
    {"name": "C", "pct": 7, "color": "#5cf2c8"},
]

WIDTH = 900
HEIGHT = 360

BG = "#0d1117"
PANEL = "#111722"
BORDER = "#1f2733"
TEXT_DIM = "#8b949e"
TEXT_BRIGHT = "#c9d1d9"

COUNT_DUR = 1.8   # seconds for numbers to count up
BAR_DUR = 1.4     # seconds for language bars to fill
CYCLE = 9.0       # full loop length (count-up + hold + reset)


def build_svg_final():
    """Actual, clean implementation (kept separate from the scratch pad above)."""
    svg = []
    svg.append(
        f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {WIDTH} {HEIGHT}" '
        f'width="{WIDTH}" height="{HEIGHT}" role="img" aria-label="GitHub stats dashboard">'
    )

    svg.append('<defs>')
    svg.append(f'''
    <linearGradient id="panelGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="{PANEL}"/>
      <stop offset="100%" stop-color="{BG}"/>
    </linearGradient>
    <linearGradient id="titleGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#39d9ff"/>
      <stop offset="50%" stop-color="#39d353"/>
      <stop offset="100%" stop-color="#b06bff"/>
    </linearGradient>
    <filter id="glow" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="2.4" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id="panelShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="18" flood-color="#000000" flood-opacity="0.55"/>
    </filter>
    <pattern id="gridPattern" width="30" height="30" patternUnits="userSpaceOnUse">
      <path d="M 30 0 L 0 0 0 30" fill="none" stroke="#1c2530" stroke-width="1"/>
    </pattern>
    ''')
    svg.append('</defs>')

    svg.append(f'<rect width="{WIDTH}" height="{HEIGHT}" fill="{BG}"/>')
    svg.append(
        f'<rect x="6" y="6" width="{WIDTH-12}" height="{HEIGHT-12}" rx="20" '
        f'fill="url(#panelGrad)" stroke="{BORDER}" stroke-width="1" filter="url(#panelShadow)"/>'
    )
    svg.append(
        f'<rect x="6" y="6" width="{WIDTH-12}" height="{HEIGHT-12}" rx="20" fill="url(#gridPattern)" opacity="0.35"/>'
    )

    svg.append(
        f'<text x="40" y="46" font-family="Segoe UI, Helvetica, Arial, sans-serif" '
        f'font-size="17" font-weight="700" letter-spacing="0.5" fill="url(#titleGrad)">GITHUB ANALYTICS</text>'
    )
    svg.append(
        f'<text x="{WIDTH-40}" y="46" text-anchor="end" font-family="Consolas, Menlo, monospace" '
        f'font-size="11" fill="{TEXT_DIM}">edit CONFIG in the .py to update numbers</text>'
    )

    svg.append(
        f'<rect id="clock" width="0" height="0" opacity="0">'
        f'<animate attributeName="opacity" from="0" to="0" dur="{CYCLE}s" '
        f'begin="0s" repeatCount="indefinite"/></rect>'
    )

    # ---------------------------------------------------------- metric cards
    card_w = (WIDTH - 80 - 3 * 18) / 4
    card_h = 108
    card_y = 68
    for i, m in enumerate(METRICS):
        cx0 = 40 + i * (card_w + 18)
        color = m["color"]
        value = m["value"]

        svg.append(
            f'<rect x="{cx0:.1f}" y="{card_y}" width="{card_w:.1f}" height="{card_h}" rx="12" '
            f'fill="#0a0e14" stroke="{BORDER}"/>'
        )
        svg.append(
            f'<rect x="{cx0:.1f}" y="{card_y}" width="4" height="{card_h}" rx="2" '
            f'fill="{color}" filter="url(#glow)"/>'
        )

        # Count-up: N discrete <set> steps stacked as separate <text> elements,
        # each visible for one time-slice (calcMode=discrete on shared clock).
        steps = 20
        step_dur = COUNT_DUR / steps
        svg.append(f'<g>')
        for s in range(steps + 1):
            shown = round(value * (s / steps))
            t0 = s * step_dur
            t1 = (s + 1) * step_dur if s < steps else CYCLE
            kt0 = round(t0 / CYCLE, 5)
            kt1 = round(min(t1 / CYCLE, 1.0), 5)
            svg.append(
                f'<text x="{cx0+20:.1f}" y="{card_y+50}" font-family="Segoe UI, Helvetica, Arial, sans-serif" '
                f'font-size="28" font-weight="800" fill="{TEXT_BRIGHT}" opacity="0">'
                f'<animate attributeName="opacity" begin="clock.begin" dur="{CYCLE}s" '
                f'repeatCount="indefinite" calcMode="discrete" '
                f'keyTimes="0;{kt0};{kt1}" values="0;1;0"/>'
                f'{shown:,}</text>'
            )
        svg.append('</g>')

        svg.append(
            f'<text x="{cx0+20:.1f}" y="{card_y+74}" font-family="Segoe UI, Helvetica, Arial, sans-serif" '
            f'font-size="12" fill="{TEXT_DIM}">{m["label"]}</text>'
        )
        svg.append(
            f'<rect x="{cx0+20:.1f}" y="{card_y+card_h-18}" width="{card_w-40:.1f}" height="3" rx="1.5" fill="{BORDER}"/>'
        )
        svg.append(
            f'<rect x="{cx0+20:.1f}" y="{card_y+card_h-18}" width="0" height="3" rx="1.5" fill="{color}" filter="url(#glow)">'
            f'<animate attributeName="width" begin="clock.begin" dur="{COUNT_DUR}s" '
            f'values="0;{card_w-40:.1f}" fill="freeze" calcMode="spline" keySplines="0.16 1 0.3 1"/>'
            f'</rect>'
        )

    # ------------------------------------------------------- language chart
    chart_y = card_y + card_h + 40
    svg.append(
        f'<text x="40" y="{chart_y}" font-family="Segoe UI, Helvetica, Arial, sans-serif" '
        f'font-size="14" font-weight="700" fill="{TEXT_BRIGHT}">Top Languages</text>'
    )
    bar_area_w = WIDTH - 80
    row_h = 30
    by = chart_y + 20
    for i, lang in enumerate(LANGUAGES):
        y = by + i * row_h
        pct = lang["pct"]
        color = lang["color"]
        bar_w = bar_area_w * (pct / 100)
        delay = 0.1 * i

        svg.append(
            f'<text x="40" y="{y+13}" font-family="Consolas, Menlo, monospace" font-size="12" fill="{TEXT_DIM}">'
            f'{lang["name"]}</text>'
        )
        svg.append(
            f'<rect x="150" y="{y}" width="{bar_area_w-150+40:.1f}" height="14" rx="7" fill="#0a0e14" stroke="{BORDER}"/>'
        )
        svg.append(
            f'<rect x="150" y="{y}" width="0" height="14" rx="7" fill="{color}" filter="url(#glow)">'
            f'<animate attributeName="width" begin="clock.begin+{delay:.2f}s" dur="{BAR_DUR}s" '
            f'values="0;{bar_w:.1f}" fill="freeze" calcMode="spline" keySplines="0.16 1 0.3 1"/>'
            f'</rect>'
        )
        svg.append(
            f'<text x="{WIDTH-40}" y="{y+12}" text-anchor="end" font-family="Consolas, Menlo, monospace" '
            f'font-size="11" fill="{TEXT_DIM}">{pct}%</text>'
        )

    svg.append('</svg>')
    return "\n".join(svg)


if __name__ == "__main__":
    out = build_svg_final()
    path = "github-stats-dashboard.svg"
    with open(path, "w") as f:
        f.write(out)
    print(f"wrote {path} ({len(out)} bytes)")
